<Window x:Class="CloudDriveSync.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CloudDriveSync.App.ViewModels"
        xmlns:infra="clr-namespace:CloudDriveSync.App.Infrastructure"
        Title="CloudDrive-Sync" Width="1080" Height="760" MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="/Assets/clouddrive-sync.ico">

    <Window.Resources>

        <!-- A synchronisation -->
        <DataTemplate x:Key="PairCard" DataType="{x:Type vm:SyncPairViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding KindGlyph}" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,12,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" FontSize="15" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <Button Content="{Binding LocalPath}" Style="{StaticResource LinkButton}" Command="{Binding OpenFolderCommand}"
                                ToolTip="Ordner im Explorer öffnen" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{Binding StatusGlyph}" Tag="{Binding Tone}" FontSize="14" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ToneIcon}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Spin">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1.4" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Spin" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsSyncing, Converter={StaticResource Visible}}">
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Border Margin="0,12,0,0" Visibility="{Binding ShowAttention, Converter={StaticResource Visible}}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource InfoBarCaution}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AttentionIsCritical}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding AttentionTitle}" Style="{StaticResource Strong}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AttentionText}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="{Binding PrimaryActionText}" Style="{StaticResource AccentButtonStyle}" Command="{Binding PrimaryActionCommand}"
                                            Visibility="{Binding PrimaryActionText, Converter={StaticResource Visible}}" />
                                    <Button Content="{Binding SecondaryActionText}" Command="{Binding SecondaryActionCommand}" Margin="8,0,0,0"
                                            Visibility="{Binding SecondaryActionText, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                <Expander Header="Technische Details" Margin="0,10,0,0" Visibility="{Binding AttentionDetail, Converter={StaticResource Visible}}">
                                    <TextBox Text="{Binding AttentionDetail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" />
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoBarCaution}" Margin="0,12,0,0" Visibility="{Binding HasLocalOnly, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="{Binding LocalOnlyTitle}" Style="{StaticResource Strong}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Der Server hat sie nicht angenommen – dort darfst du vermutlich nur lesen. Sie bleiben erhalten, werden aber nicht abgeglichen." />
                                <Expander Header="Dateien" Margin="0,8,0,0">
                                    <TextBox Text="{Binding LocalOnlyList, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" />
                                </Expander>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Im Ordner zeigen" Command="{Binding ShowLocalOnlyCommand}" />
                                    <Button Content="Erneut versuchen" Command="{Binding RetryLocalOnlyCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Content="{Binding ConflictText}" Style="{StaticResource LinkButton}" Command="{Binding ShowConflictsCommand}" Margin="0,10,0,0"
                                Visibility="{Binding ConflictCount, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding SyncNowCommand}" ToolTip="Jetzt synchronisieren" AutomationProperties.Name="Jetzt synchronisieren">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" />
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding OpenFolderCommand}" ToolTip="Ordner öffnen" AutomationProperties.Name="Ordner öffnen">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" />
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Einstellungen" AutomationProperties.Name="Einstellungen">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" ToolTip="Weitere Aktionen" Click="OnMoreClick" AutomationProperties.Name="Weitere Aktionen">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Jetzt synchronisieren" Command="{Binding SyncNowCommand}" />
                                    <MenuItem Header="{Binding PauseText}" Command="{Binding TogglePauseCommand}" />
                                    <MenuItem Header="Einstellungen …" Command="{Binding OpenSettingsCommand}" />
                                    <MenuItem Header="Neu aufbauen …" Command="{Binding RebuildCommand}" />
                                    <MenuItem Header="Papierkorb anzeigen" Command="{Binding ShowTrashCommand}" />
                                    <Separator />
                                    <MenuItem Header="Synchronisation beenden …" Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A synchronisation as a row on its account's card: the interval right there, everything else in its settings -->
        <DataTemplate x:Key="AccountSyncRow" DataType="{x:Type vm:SyncPairViewModel}">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FolderTitle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LocalPath}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalPath}" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding IntervalChoices}" DisplayMemberPath="Title" SelectedValuePath="Value"
                          SelectedValue="{Binding IntervalMinutes}" MinWidth="170" Margin="12,0,0,0" VerticalAlignment="Center"
                          ToolTip="{x:Static vm:SyncChoices.IntervalExplanation}" AutomationProperties.Name="Änderungen aus der Cloud holen" />
                <Button Grid.Column="2" Content="Einstellungen …" Command="{Binding OpenSettingsCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- An account -->
        <DataTemplate x:Key="AccountCard" DataType="{x:Type vm:AccountViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,12,0">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Strong}" FontSize="15" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <StackPanel Margin="0,12,0,0" HorizontalAlignment="Left" Width="320" Visibility="{Binding HasQuota, Converter={StaticResource Visible}}">
                            <ProgressBar Value="{Binding QuotaPercent, Mode=OneWay}" Maximum="100" />
                            <TextBlock Text="{Binding QuotaText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Text="Noch kein Ordner dieses Kontos wird synchronisiert." Style="{StaticResource Secondary}" Margin="0,12,0,0"
                                   Visibility="{Binding HasSyncs, Converter={StaticResource Hidden}}" />
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding HasSyncs, Converter={StaticResource Visible}}">
                            <TextBlock Text="Synchronisierte Ordner" Style="{StaticResource Strong}" />
                            <TextBlock Text="Wie oft Änderungen aus der Cloud geholt werden, stellst du hier direkt ein; alles Weitere unter „Einstellungen“."
                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <infra:CardList ItemsSource="{Binding Syncs}" ItemTemplate="{StaticResource AccountSyncRow}" />
                        </StackPanel>
                        <Button Command="{Binding AddSyncCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" AutomationProperties.Name="{Binding AddSyncText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" />
                                <TextBlock Text="{Binding AddSyncText}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource SubtleButton}" ToolTip="Weitere Aktionen" Click="OnMoreClick" AutomationProperties.Name="Weitere Aktionen zum Konto">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding AddSyncText}" Command="{Binding AddSyncCommand}" />
                                    <MenuItem Header="Neu anmelden …" Command="{Binding ReloginCommand}" />
                                    <MenuItem Header="Papierkorb anzeigen" Command="{Binding ShowTrashCommand}" />
                                    <Separator />
                                    <MenuItem Header="Konto entfernen …" Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A finished run -->
        <DataTemplate x:Key="ActivityRow" DataType="{x:Type vm:ActivityItem}">
            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ToneIcon}" Tag="{Binding Tone}" Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                        <TextBlock Text="{Binding PairTitle}" Style="{StaticResource Strong}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0">
                            <Run Text="{Binding Summary, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource Caption}" VerticalAlignment="Top" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A conflict copy -->
        <DataTemplate x:Key="ConflictRow" DataType="{x:Type vm:ConflictItem}">
            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" />
                        <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Öffnen" Command="{Binding OpenCommand}" />
                        <Button Content="Im Ordner zeigen" Command="{Binding ShowInFolderCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- A file in the recycle bin -->
        <DataTemplate x:Key="TrashRow" DataType="{x:Type vm:TrashItemViewModel}">
            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Wiederherstellen" Command="{Binding RestoreCommand}" />
                        <Button Style="{StaticResource SubtleButton}" ToolTip="Weitere Aktionen" Click="OnMoreClick" Margin="4,0,0,0" AutomationProperties.Name="Weitere Aktionen zur Datei">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Im Ordner zeigen" Command="{Binding ShowInFolderCommand}" />
                                    <Separator />
                                    <MenuItem Header="Endgültig löschen …" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- The recycle bin of one synchronisation -->
        <DataTemplate x:Key="TrashGroup" DataType="{x:Type vm:TrashGroupViewModel}">
            <StackPanel Margin="0,20,0,0" Visibility="{Binding IsVisible, Converter={StaticResource Visible}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
                        <Button Content="Ordner öffnen" Command="{Binding OpenFolderCommand}" />
                        <Button Content="Leeren …" Command="{Binding EmptyCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" FontSize="15" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource InfoBarCaution}" Margin="0,10,0,0" Visibility="{Binding HasCloudLeftover, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Auf dem Server löschen …" Command="{Binding RemoveCloudLeftoverCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding CloudLeftoverText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0" Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
                    <infra:CardList ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TrashRow}" />
                </Border>
                <TextBlock Text="{Binding MoreText}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding MoreText, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- While CloudDrive-Sync starts, or when it could not start -->
        <Grid Visibility="{Binding Startup, Converter={StaticResource HiddenIf}, ConverterParameter=Ready}">
            <Border Style="{StaticResource Card}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                <StackPanel>
                    <Image Source="/Assets/clouddrive-sync.png" Width="48" Height="48" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="CloudDrive-Sync" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding Startup, Converter={StaticResource VisibleIf}, ConverterParameter=Starting}">
                        <TextBlock Text="{Binding StartupText}" Style="{StaticResource Secondary}" />
                        <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding Startup, Converter={StaticResource VisibleIf}, ConverterParameter=Failed}">
                        <Border Style="{StaticResource InfoBarCritical}">
                            <StackPanel>
                                <TextBlock Text="{Binding StartupErrorTitle}" Style="{StaticResource Strong}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StartupErrorText}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Erneut versuchen" Style="{StaticResource AccentButtonStyle}" Command="{Binding RetryStartCommand}" Margin="0,0,8,8" />
                            <Button Content="Anmeldungen zurücksetzen …" Command="{Binding ResetConfigurationCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding CanResetConfiguration, Converter={StaticResource Visible}}" />
                            <Button Content="Protokolle öffnen" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The program -->
        <Grid Visibility="{Binding Startup, Converter={StaticResource VisibleIf}, ConverterParameter=Ready}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="12,16,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,24">
                    <Image Source="/Assets/clouddrive-sync.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="CloudDrive-Sync" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource AccentButtonStyle}" Command="{Binding AddSyncCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8" AutomationProperties.Name="Ordner synchronisieren">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" />
                        <TextBlock Text="Ordner synchronisieren" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNav}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Background="{DynamicResource SystemFillColorCautionBrush}"
                                        Visibility="{Binding Badge, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <Grid>

                    <!-- Overview -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentPage, Converter={StaticResource VisibleIf}, ConverterParameter=Overview}">
                        <StackPanel Margin="36,28,36,36">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding SyncAllCommand}" VerticalAlignment="Center" AutomationProperties.Name="Alle jetzt synchronisieren"
                                        Visibility="{Binding HasPairs, Converter={StaticResource Visible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="14" />
                                        <TextBlock Text="Alle jetzt synchronisieren" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Übersicht" Style="{StaticResource PageTitle}" />
                            </DockPanel>

                            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ToneIcon}" Tag="{Binding SummaryTone}" Text="{Binding SummaryGlyph}" FontSize="32" />
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SummaryTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- A new version -->
                            <Border Style="{StaticResource InfoBar}" Margin="0,12,0,0" Visibility="{Binding Updates.ShowNotice, Converter={StaticResource Visible}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE896;" VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Updates.NoticeText}" TextWrapping="Wrap" />
                                        <ProgressBar Value="{Binding Updates.Progress, Mode=OneWay}" Maximum="100" Margin="0,10,0,0"
                                                     Visibility="{Binding Updates.IsDownloading, Converter={StaticResource Visible}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="{Binding Updates.InstallText}" Style="{StaticResource AccentButtonStyle}" Command="{Binding Updates.InstallCommand}"
                                                    IsEnabled="{Binding Updates.IsBusy, Converter={StaticResource Not}}" />
                                            <Button Content="Später" Command="{Binding Updates.DismissCommand}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="24" Visibility="{Binding ShowWelcome, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Text="In drei Schritten startklar" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,10,0,0" LineHeight="22"
                                               Text="1.  Konto verbinden – Nextcloud, IServ oder ein anderer WebDAV-Speicher.&#x0a;2.  Cloud-Ordner wählen – alles oder nur bestimmte Ordner und Dateien.&#x0a;3.  Speicherort auf diesem PC wählen – CloudDrive-Sync hält beide Seiten aktuell, in beide Richtungen." />
                                    <Button Content="Konto verbinden" Style="{StaticResource AccentButtonStyle}" Command="{Binding AddAccountCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="24" Visibility="{Binding ShowNoPairs, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Text="Welcher Ordner soll auf diesen PC?" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,10,0,0"
                                               Text="Wähle einen Cloud-Ordner und einen Speicherort. Änderungen und Löschungen auf beiden Seiten werden automatisch abgeglichen; was der Abgleich am PC löscht oder ersetzt, bleibt im versteckten Papierkorb-Ordner erhalten." />
                                    <Button Content="Ordner synchronisieren …" Style="{StaticResource AccentButtonStyle}" Command="{Binding AddSyncCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Synchronisationen" Style="{StaticResource SectionTitle}" Visibility="{Binding HasPairs, Converter={StaticResource Visible}}" />
                            <infra:CardList ItemsSource="{Binding Pairs}" ItemTemplate="{StaticResource PairCard}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Accounts -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentPage, Converter={StaticResource VisibleIf}, ConverterParameter=Accounts}">
                        <StackPanel Margin="36,28,36,36">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Command="{Binding AddAccountCommand}" VerticalAlignment="Center" AutomationProperties.Name="Konto verbinden">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" />
                                        <TextBlock Text="Konto verbinden" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Konten" Style="{StaticResource PageTitle}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,20"
                                       Text="Deine Anmeldungen bei Nextcloud, IServ und anderen Speichern. Sie liegen nur verschlüsselt auf diesem PC." />
                            <infra:CardList ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource AccountCard}" />
                            <Border Style="{StaticResource Card}" Padding="24" Visibility="{Binding HasAccounts, Converter={StaticResource Hidden}}">
                                <TextBlock Style="{StaticResource Secondary}" Text="Noch kein Konto verbunden." />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Activity -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentPage, Converter={StaticResource VisibleIf}, ConverterParameter=Activity}">
                        <StackPanel Margin="36,28,36,36">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Protokolle öffnen" Command="{Binding OpenLogsCommand}" VerticalAlignment="Center" />
                                <TextBlock Text="Aktivität" Style="{StaticResource PageTitle}" />
                            </DockPanel>
                            <StackPanel Visibility="{Binding Conflicts.Count, Converter={StaticResource Visible}}">
                                <TextBlock Text="Konflikte" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,10"
                                           Text="Diese Dateien wurden auf beiden Seiten geändert. CloudDrive-Sync hat beide Fassungen behalten – die Kopie trägt „Konflikt“ im Namen. Prüfe sie und lösche die Fassung, die du nicht mehr brauchst; das wird überall übernommen." />
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <infra:CardList ItemsSource="{Binding Conflicts}" ItemTemplate="{StaticResource ConflictRow}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Letzte Änderungen" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding Activity.Count, Converter={StaticResource Visible}}">
                                <infra:CardList ItemsSource="{Binding Activity}" ItemTemplate="{StaticResource ActivityRow}" />
                            </Border>
                            <TextBlock Style="{StaticResource Secondary}" Text="Bisher wurde nichts übertragen oder gelöscht." Visibility="{Binding Activity.Count, Converter={StaticResource Hidden}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Recycle bin -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentPage, Converter={StaticResource VisibleIf}, ConverterParameter=Trash}">
                        <StackPanel Margin="36,28,36,36" DataContext="{Binding Trash}">
                            <TextBlock Text="Papierkorb" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0"
                                       Text="Hier liegen Dateien, die der Abgleich auf diesem PC gelöscht oder ersetzt hat – weil sie in der Cloud gelöscht oder geändert wurden. Was du selbst am PC löschst, liegt im Papierkorb von Windows; Nextcloud hat dazu einen eigenen Papierkorb." />
                            <TextBlock Text="{Binding RetentionText}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            <Border Style="{StaticResource Card}" Padding="24" Margin="0,20,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                                <TextBlock Style="{StaticResource Secondary}" Text="Der Papierkorb ist leer." />
                            </Border>
                            <infra:CardList ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource TrashGroup}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentPage, Converter={StaticResource VisibleIf}, ConverterParameter=Settings}">
                        <StackPanel Margin="36,28,36,36" DataContext="{Binding Settings}">
                            <TextBlock Text="Einstellungen" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Allgemein" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanStartWithWindows}" AutomationProperties.Name="Mit Windows starten">
                                    <StackPanel>
                                        <TextBlock Text="Mit Windows starten" Style="{StaticResource Strong}" />
                                        <TextBlock Text="CloudDrive-Sync startet unsichtbar im Infobereich und hält deine Ordner aktuell." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Notifications}" AutomationProperties.Name="Benachrichtigungen">
                                    <StackPanel>
                                        <TextBlock Text="Benachrichtigungen" Style="{StaticResource Strong}" />
                                        <TextBlock Text="Bei Konflikten und wenn eine Synchronisation deine Entscheidung braucht." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Papierkorb von CloudDrive-Sync" Style="{StaticResource Strong}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   Text="Was der Abgleich am PC löscht oder ersetzt, bleibt so lange im Papierkorb von CloudDrive-Sync – ansehen und wiederherstellen kannst du es unter „Papierkorb“. „Aus“: nichts wird aufbewahrt." />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding TrashChoices}" DisplayMemberPath="Title" SelectedValuePath="Value"
                                              SelectedValue="{Binding TrashDays}" MinWidth="140" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="{Binding Updates.InstallText}" Style="{StaticResource AccentButtonStyle}" Command="{Binding Updates.InstallCommand}" Margin="0,0,8,0"
                                                    Visibility="{Binding Updates.CanInstall, Converter={StaticResource Visible}}" IsEnabled="{Binding Updates.IsBusy, Converter={StaticResource Not}}" />
                                            <Button Content="Nach Updates suchen" Command="{Binding Updates.CheckNowCommand}" IsEnabled="{Binding Updates.IsInstalled}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="CloudDrive-Sync aktuell halten" Style="{StaticResource Strong}" />
                                            <TextBlock Text="{Binding Updates.StatusText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Value="{Binding Updates.Progress, Mode=OneWay}" Maximum="100" Margin="0,10,0,0"
                                                 Visibility="{Binding Updates.IsDownloading, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="Neue Versionen" Margin="0,16,0,6" />
                                    <ComboBox ItemsSource="{Binding UpdateChoices}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding UpdateMode}"
                                              AutomationProperties.Name="Neue Versionen" IsEnabled="{Binding Updates.IsInstalled}" />
                                    <TextBlock Text="{Binding UpdateHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TestVersions}" Margin="0,14,0,0" IsEnabled="{Binding Updates.IsInstalled}"
                                              AutomationProperties.Name="Testversionen erhalten">
                                        <StackPanel>
                                            <TextBlock Text="Testversionen erhalten" />
                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                       Text="Vorabversionen zum Ausprobieren: Sie kommen vor allen anderen, können aber noch Fehler haben." />
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                                               Text="Updates kommen nur aus dem GitHub-Projekt von CloudDrive-Sync; jedes Paket wird vor der Installation anhand seiner Prüfsumme kontrolliert." />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Programm und Daten" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Strong}">
                                        <Run Text="CloudDrive-Sync " /><Run Text="{Binding Version, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding EngineVersion}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,10,0,0"
                                               Text="Zugangsdaten liegen nur verschlüsselt auf diesem PC; der Schlüssel steckt in der Windows-Anmeldeinformationsverwaltung. CloudDrive-Sync überträgt nichts an Dritte." />
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Datenordner öffnen" Command="{Binding OpenDataFolderCommand}" />
                                        <Button Content="Protokolle öffnen" Command="{Binding OpenLogsCommand}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Cloud-Laufwerke" Style="{StaticResource Strong}" />
                                        <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                                                   Text="Laufwerke ohne lokale Kopie (z. B. M: für OneDrive) richtet das Programm CloudDrives ein. Beide Programme arbeiten unabhängig voneinander." />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="CloudDrives öffnen" Command="{Binding OpenDrivesCommand}" VerticalAlignment="Center"
                                            Visibility="{Binding HasDrivesProgram, Converter={StaticResource Visible}}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- About -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentPage, Converter={StaticResource VisibleIf}, ConverterParameter=About}">
                        <StackPanel Margin="36,28,36,36" DataContext="{Binding About}">
                            <TextBlock Text="Über CloudDrive-Sync" Style="{StaticResource PageTitle}" />
                            <Border Style="{StaticResource Card}" Padding="24" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="/Assets/clouddrive-sync.png" Width="64" Height="64" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                        <TextBlock Text="CloudDrive-Sync" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Copyright}" Style="{StaticResource Strong}" Margin="0,16,0,0" />
                                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="Freie Software unter der MIT-Lizenz. Dokumentation und Grafiken stehen unter CC BY 4.0." />
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Command="{Binding OpenProjectCommand}" Margin="0,0,8,0" AutomationProperties.Name="Projekt auf GitHub">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="14" />
                                                    <TextBlock Text="Projekt auf GitHub" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Content="Lizenztext" Command="{Binding OpenLicenseCommand}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ProjectUrl}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Verwendete Bausteine" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <infra:CardList ItemsSource="{Binding Components}">
                                        <infra:CardList.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:Component}">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" />
                                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                                            <Run Text="{Binding Purpose, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding License, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Holder, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Website" VerticalAlignment="Center" Margin="12,0,0,0"
                                                            Command="{Binding DataContext.OpenComponentCommand, RelativeSource={RelativeSource AncestorType=infra:CardList}}" CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding Name, StringFormat='Website von {0}'}" />
                                                </Grid>
                                            </DataTemplate>
                                        </infra:CardList.ItemTemplate>
                                    </infra:CardList>
                                    <Button Content="Alle Lizenzhinweise anzeigen" Style="{StaticResource LinkButton}" Command="{Binding OpenNoticesCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
