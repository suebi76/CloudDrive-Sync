<Window x:Class="CloudDriveSync.App.Views.VerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CloudDriveSync.App.ViewModels"
        xmlns:infra="clr-namespace:CloudDriveSync.App.Infrastructure"
        Title="Abgleich überprüfen" Width="660" Height="660" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/clouddrive-sync.ico">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Jetzt synchronisieren" Style="{StaticResource AccentButtonStyle}" Command="{Binding SyncNowCommand}" MinWidth="120" Margin="0,0,8,0"
                        Visibility="{Binding CanSyncNow, Converter={StaticResource Visible}}" />
                <Button Content="Schließen" IsCancel="True" MinWidth="96" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="28,22,28,6">
            <TextBlock Text="Abgleich überprüfen" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,10,28,16">
                <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                           Text="CloudDrive-Sync vergleicht jede Datei am PC mit der in der Cloud. Dabei wird nichts verändert. Dateien, die bewusst nur auf diesem PC bleiben, zählen nicht mit." />
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CompareContent}" IsEnabled="{Binding CanCheck}" Margin="0,16,0,0"
                          AutomationProperties.Name="Auch die Inhalte vergleichen">
                    <StackPanel>
                        <TextBlock Text="Auch die Inhalte vergleichen" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Lädt alle Dateien einmal herunter – bei großen Ordnern dauert das länger." />
                    </StackPanel>
                </CheckBox>
                <Button Content="Jetzt prüfen" Style="{StaticResource AccentButtonStyle}" Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}"
                        HorizontalAlignment="Left" Margin="0,16,0,0" MinWidth="120" />

                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>

                <Border Style="{StaticResource InfoBarCritical}" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ToneIcon}" Tag="{Binding Tone}" Text="{Binding ResultGlyph}" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource Strong}" FontSize="16" />
                                <TextBlock Text="{Binding ResultText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <infra:CardList ItemsSource="{Binding Groups}" Margin="0,8,0,0">
                            <infra:CardList.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DifferenceGroup}">
                                    <Expander Header="{Binding Header}" Margin="0,8,0,0">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <TextBox Text="{Binding List, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" MaxHeight="220"
                                                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Title}" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </infra:CardList.ItemTemplate>
                        </infra:CardList>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
