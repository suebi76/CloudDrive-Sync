<Window x:Class="CloudDriveSync.App.Views.EndSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Heading}" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/clouddrive-sync.ico">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding PrimaryText}" Style="{StaticResource AccentButtonStyle}" Command="{Binding EndCommand}" MinWidth="120"
                        Visibility="{Binding HasResult, Converter={StaticResource Hidden}}" />
                <Button Content="In den Papierkorb" Style="{StaticResource AccentButtonStyle}" Command="{Binding RemoveRestCommand}" MinWidth="140"
                        Visibility="{Binding HasRest, Converter={StaticResource Visible}}" />
                <Button Content="{Binding CloseText}" Command="{Binding CloseCommand}" IsCancel="True" MinWidth="110" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Margin="28,24,28,20">
            <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Intro}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,10,0,0" />

            <StackPanel Margin="0,18,0,0" IsEnabled="{Binding CanChoose}" Visibility="{Binding HasPairs, Converter={StaticResource Visible}}">
                <TextBlock Text="Was soll auf diesem PC bleiben?" Style="{StaticResource Strong}" Margin="0,0,0,10" />
                <RadioButton GroupName="Keep" IsChecked="{Binding KeepOnPc}" Margin="0,0,0,10" AutomationProperties.Name="{Binding KeepTitle}">
                    <StackPanel>
                        <TextBlock Text="{Binding KeepTitle}" />
                        <TextBlock Text="{Binding KeepText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Keep" IsChecked="{Binding KeepEverything}" Margin="0,0,0,10" AutomationProperties.Name="Alles herunterladen und behalten"
                             Visibility="{Binding HasOnDemand, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="Alles herunterladen und behalten" />
                        <TextBlock Text="{Binding EverythingText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Keep" IsChecked="{Binding KeepNothing}" AutomationProperties.Name="Vom PC löschen">
                    <StackPanel>
                        <TextBlock Text="Vom PC löschen" />
                        <TextBlock Text="{Binding NothingText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsWorking, Converter={StaticResource Visible}}">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="{Binding Progress}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
            <Border Style="{StaticResource InfoBarCritical}" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource InfoBarCaution}" Margin="0,16,0,0" Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
