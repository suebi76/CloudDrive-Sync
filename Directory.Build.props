<Project>
  <!-- Common settings of every CloudDrive-Sync project. -->
  <PropertyGroup>
    <!-- No Windows SDK version on purpose: it would bring Microsoft's projection of the Windows SDK, which is not open
         source. Files on demand need Windows 10 1809 - that code says so itself ([SupportedOSPlatform]), and its few
         Windows Runtime calls go directly through COM (CloudFiles/WinRtSyncRootManager.cs). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Product>CloudDrive-Sync</Product>
    <Company>Steffen Schwabe</Company>
    <Authors>Steffen Schwabe</Authors>
    <Copyright>© 2026 Steffen Schwabe</Copyright>
    <Version>0.3.0-preview.7</Version>
    <NeutralLanguage>de</NeutralLanguage>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>

    <!-- The sources live in a folder that OneDrive synchronises; build output goes outside of it. The folder name of
         the project is the key, so WPF's temporary markup projects land in the same place. -->
    <CloudDriveSyncProjectKey>$([System.IO.Path]::GetFileName('$(MSBuildProjectDirectory)'))</CloudDriveSyncProjectKey>
    <CloudDriveSyncBuildRoot>$(USERPROFILE)\.clouddrive-sync-build\</CloudDriveSyncBuildRoot>
    <BaseOutputPath>$(CloudDriveSyncBuildRoot)$(CloudDriveSyncProjectKey)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(CloudDriveSyncBuildRoot)$(CloudDriveSyncProjectKey)\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
